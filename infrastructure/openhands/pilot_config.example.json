    "cwd": "/fact_home/yishi/agent-checkpoint-stage1"
  },
  "checkpoint": {
    "command": [
      "infrastructure/firecracker/create_full_snapshot.sh",
      "--socket",
      "runs/pilot/pilot-REPLACE_ME/firecracker-original.sock",
      "--output-dir",
      "runs/pilot/pilot-REPLACE_ME/checkpoint",
      "--disk-state",
      "runs/pilot/pilot-REPLACE_ME/guest-disk.img"
    ],
    "memory_snap": "runs/pilot/pilot-REPLACE_ME/checkpoint/memory.snap",
    "vmstate_snap": "runs/pilot/pilot-REPLACE_ME/checkpoint/vmstate.snap",
    "disk_state": "runs/pilot/pilot-REPLACE_ME/checkpoint/disk.img",
    "host_agent_prefix": "runs/pilot/pilot-REPLACE_ME/checkpoint/host_agent_prefix.json",
    "checkpoint_id": "pilot-REPLACE_ME-cp0",
    "cwd": "/fact_home/yishi/agent-checkpoint-stage1"
  },
  "terminate_original_vmm_command": [
    "infrastructure/firecracker/terminate_vmm.sh",
