  ],
  "require_explicit_vmm_termination": true,
  "restore": {
    "command": [
      "infrastructure/firecracker/restore_full_snapshot.sh",
      "--checkpoint-dir",
      "runs/pilot/pilot-REPLACE_ME/checkpoint",
      "--socket",
      "runs/pilot/pilot-REPLACE_ME/firecracker-restored.sock",
      "--new-pid-file",
      "runs/pilot/pilot-REPLACE_ME/firecracker-restored.pid",
      "--evidence-file",
      "runs/pilot/pilot-REPLACE_ME/restore_evidence.json"
    ],
    "new_vmm_pid_file": "runs/pilot/pilot-REPLACE_ME/firecracker-restored.pid",
    "evidence_file": "runs/pilot/pilot-REPLACE_ME/restore_evidence.json",
    "cwd": "/fact_home/yishi/agent-checkpoint-stage1"
  },
  "continuation": {
    "run_command": [
      "infrastructure/openhands/resume_headless_guest.sh",
