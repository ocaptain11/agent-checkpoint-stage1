{
  "run_id": "pilot-REPLACE_ME",
  "real_guest_required": true,
  "official_evaluator": true,
  "manual_replay": false,
  "guest_fallback": false,
  "gold_patch_injected": false,
  "command_timeout_seconds": 3600,
  "vllm": {
    "start_command": [
      "sbatch",
      "infrastructure/slurm/start_vllm.sbatch"
    ],
    "health_url": "http://MODEL_NODE:8000/health",
    "health_timeout_seconds": 300,
    "cwd": "/fact_home/yishi/agent-checkpoint-stage1"
  },
  "firecracker": {
    "start_command": [
      "infrastructure/firecracker/start_guest.sh",
      "--socket",
      "runs/pilot/pilot-REPLACE_ME/firecracker-original.sock",
      "--pid-file",
      "runs/pilot/pilot-REPLACE_ME/firecracker-original.pid"
    ],
    "socket_path": "runs/pilot/pilot-REPLACE_ME/firecracker-original.sock",
    "kvm_path": "/dev/kvm",
    "require_kvm": true,
    "cwd": "/fact_home/yishi/agent-checkpoint-stage1"
  },
  "openhands": {
    "run_command": [
      "infrastructure/openhands/run_headless_guest.sh",
      "--task-id",
